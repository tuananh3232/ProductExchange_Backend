STAFF_INVITATION_URL_TEMPLATE=

# MongoDB
# MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/productexchange
# DB_NAME=productexchange
MONGODB_URI=mongodb+srv://anhntse183220_db_user:12345@cluster0.tlye7u0.mongodb.net/anhdecor
DB_NAME=anhdecor

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
