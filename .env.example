# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ORDER_CONFIRMATION_WINDOW_HOURS=72
ORDER_CASE_WINDOW_HOURS=168
KYC_REJECTED_RETENTION_DAYS=30
STAFF_INVITATION_PATH=/shop/invitations
# Optional. Supports {invitationId} and {shopId}; overrides FRONTEND_URL + STAFF_INVITATION_PATH when set.
STAFF_INVITATION_URL_TEMPLATE=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/anhdecor?replicaSet=rs0
DB_NAME=anhdecor

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ProductExchange

# Google OAuth
GOOGLE_CLIENT_ID=

# VNPay
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=DEMO
VNPAY_HASH_SECRET=DEMO_HASH_SECRET
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_RETURN_URL=http://localhost:5173/payment/return
VNPAY_IPN_URL=http://localhost:3000/api/v1/payments/vnpay/ipn
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/return
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Feature flags (money and advanced features are opt-in)
COMMERCE_ENABLED=false
PAYOS_PAYMENTS_ENABLED=false
VNPAY_PAYMENTS_ENABLED=false
WALLET_PAYMENTS_ENABLED=false
WITHDRAWALS_ENABLED=false
EXCHANGE_ENABLED=false
RENTAL_ENABLED=false
SUBSCRIPTION_PAYMENT_ENABLED=false
ROOM_VISUALIZER_ENABLED=false

# Production money flows require MongoDB replica set / mongos transactions.
REQUIRE_MONGO_TRANSACTIONS=true
# Chỉ đặt true trong phiên migration sau khi backup và thử khôi phục thành công.
MIGRATION_BACKUP_CONFIRMED=false
